---
import Base from '../layouts/Base.astro';
import { locations, areaList } from '../data/site';
import { locationContent } from '../data/location-content';
---
<Base title="Areas We Serve | Masonry Contractor Pompano Beach & Broward" description="Masonry services in Pompano Beach and the surrounding Broward County and southern Palm Beach County cities within about a 30-minute drive.">
  <section class="page-hero"><div class="wrap"><h1>Areas We Serve</h1><p>Based in Pompano Beach, serving cities within roughly a 30-minute drive.</p></div></section>
  <section class="section"><div class="wrap">
    <h2>Cities we work in</h2>
    <p>We take masonry projects in Pompano Beach and the surrounding cities of Broward County and southern Palm Beach County. Drive times are approximate.</p>
    <ul class="pills">{areaList.map(a => <li>{a.slug ? <a href={`/${a.slug}/`}>{a.city}</a> : <span class="pill">{a.city}</span>}</li>)}</ul>
  </div></section>
  <section class="section alt"><div class="wrap">
    <h2>Local information</h2>
    <div class="grid3">
      {locations.map(l => <div class="card"><h3><a href={`/${l.slug}/`}>Masonry contractor in {l.city}</a></h3><p>{locationContent[l.slug].blurb}</p></div>)}
    </div>
  </div></section>
</Base>
